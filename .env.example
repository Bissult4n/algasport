# Optional, PUBLIC build-time settings. Never put tokens or secrets here.
# The shop works without an env file, using defaults from lib/shop-config.ts.
# Copy to .env.local only if you need overrides, then uncomment selected lines.

# Optional WhatsApp override. Use international digits without + or spaces.
# NEXT_PUBLIC_WHATSAPP_NUMBER=77751775141
# NEXT_PUBLIC_INSTAGRAM_USERNAME=alga_sport_shops

# Canonical HTTPS origin for link previews; Vercel also supplies VERCEL_URL.
# NEXT_PUBLIC_SITE_URL=

# Leave unset for Vercel. GitHub Pages project example: /repository-name
# NEXT_PUBLIC_BASE_PATH=

# Staging is not indexed. Enable only after a confirmed public launch.
# NEXT_PUBLIC_ALLOW_INDEXING=true
